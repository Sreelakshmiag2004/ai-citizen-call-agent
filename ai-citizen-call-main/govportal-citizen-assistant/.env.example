# Base URL of the Citizen Call Intelligence FastAPI backend.
# Swagger docs: http://127.0.0.1:8001/docs
VITE_API_URL=http://127.0.0.1:8001

# The Twilio phone number citizens call to reach the /twilio/voice pipeline
# (must match backend/.env's TWILIO_PHONE_NUMBER). Not a secret -- it's a
# number meant to be dialed -- so it's safe to expose in the frontend
# bundle. Never put TWILIO_ACCOUNT_SID or TWILIO_AUTH_TOKEN here or anywhere
# else in this frontend; those stay backend-only.
VITE_TWILIO_PHONE_NUMBER=
