LLM_API_KEY=your_key_here
LLM_MODEL=gemini-3.6-flash

# AI provider selection -- "gemini" (default) or "groq" for LLM_PROVIDER,
# "local" (default, faster-whisper) or "groq" for STT_PROVIDER. Leaving
# both unset/default keeps the app exactly as it already behaves. Set
# either to "groq" once GROQ_API_KEY below is filled in to make GroqCloud
# the active provider for that step -- Gemini and local Whisper are not
# removed and remain available by switching the value back.
LLM_PROVIDER=gemini
STT_PROVIDER=local

# GroqCloud (https://console.groq.com) -- required only if LLM_PROVIDER
# and/or STT_PROVIDER above is set to "groq". Never sent to or readable by
# the frontend; used exclusively by backend/app/services/providers/groq_provider.py.
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
# Chatbot (public RAG FAQ assistant, see app/services/chatbot_service.py)
# chat-completion model -- separate from GROQ_LLM_MODEL above so it can be
# tuned independently of complaint analysis. Defaults to GROQ_LLM_MODEL if unset.
GROQ_CHATBOT_MODEL=

# Authentication -- JWT signing secret. REQUIRED for any real deployment;
# if left blank, the backend generates a random per-process secret at
# startup (fine for local dev, but invalidates all tokens on every
# restart, and must never happen in production). Generate one with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DUPLICATE_THRESHOLD=0.85
RELATED_THRESHOLD=0.65

# Maximum size (in MB) accepted for an uploaded audio file across
# /transcribe, /process-complaint, and /process-and-create-ticket. 25 MB
# comfortably covers a short citizen complaint recording. Uploads over
# this limit are rejected with 413 before being fully read into memory.
MAX_AUDIO_UPLOAD_MB=25

# Rate limiting (see app/core/rate_limit.py) -- lightweight, in-memory,
# per-process. Protects the AI-cost-sensitive pipeline endpoints
# (/transcribe, /analyze, /process-complaint, /process-and-create-ticket,
# /duplicate-check), keyed per authenticated user, and the two
# unauthenticated auth endpoints (/auth/login, /auth/register), keyed per
# client IP as an anti-brute-force/anti-spam-registration measure. Leave
# unset for the defaults below; set RATE_LIMIT_ENABLED=false to disable
# entirely (e.g. for local debugging).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_REQUESTS=20
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# The public, unauthenticated chatbot (/chatbot/message) gets its own
# bucket, keyed per client IP -- see app/core/rate_limit.py.
RATE_LIMIT_CHATBOT_REQUESTS=15
RATE_LIMIT_CHATBOT_WINDOW_SECONDS=60

# Chatbot RAG retrieval (see app/services/chatbot_service.py). Minimum
# cosine similarity a knowledge document must score to be considered
# relevant enough to answer from; below this, the chatbot says it doesn't
# have the answer instead of asking Groq to guess. 0.0-1.0.
RAG_MIN_SIMILARITY=0.45

# Module 8A -- Twilio Programmable Voice (phone call -> recording input).
# Leave blank to run without phone-call support; the browser audio upload
# keeps working either way. Find these in the Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS base URL Twilio can reach (e.g. your ngrok URL). Required
# for Twilio signature validation and for building the recording status
# callback URL correctly when running behind a tunnel.
TWILIO_PUBLIC_BASE_URL=
